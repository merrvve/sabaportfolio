---
import { ExpBottom } from "./AboutMotion/ExpBottom";
import { SkillsBottom } from "./AboutMotion/SkillsBottom";
import { ExperienceContent } from "./AboutMotion/ExperienceContent";
---
<section class="flex flex-col gap-2 relative min-h-screen">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between px-6 md:px-16 pt-6">
        <h1 class="font-bold text-3xl italic scroll-animation scroll-animation-default delay-300">Experience</h1>
        <h1 class="font-bold text-3xl italic scroll-animation scroll-animation-default delay-300">Award&amp;Exhibitions</h1>
    </div>

    <div class="mt-1 hidden md:block">
        <ExpBottom client:load />
    </div>

    <ExperienceContent client:load />

    <div class="px-6 md:px-16 mt-4">
        <h1 class="font-bold text-3xl italic scroll-animation scroll-animation-default delay-300">Skills</h1>
    </div>

    <div class="absolute bottom-3 left-40 hidden md:block">
        <SkillsBottom client:load />
    </div>
</section>
