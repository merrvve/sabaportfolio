---
import { ExpBottom } from "./AboutMotion/ExpBottom";
import { SkillsBottom } from "./AboutMotion/SkillsBottom";
import { SkillsLeft } from "./AboutMotion/SkillsLeft";
import { ExperienceContent } from "./AboutMotion/ExperienceContent";
import { SkillsContent } from "./AboutMotion/SkillsContent";
---

<section class="flex flex-col gap-2 relative">
  
    
    <div
      class="flex flex-col md:flex-row md:items-center md:justify-between px-6 md:pl-48 pt-8 md:pt-6 gap-2 md:gap-0"
    >
      <h1
        class="font-bold text-3xl italic scroll-animation scroll-animation-default delay-300"
      >
        Experience
      </h1>
      <h1
        class="md:mr-24 font-bold text-3xl italic scroll-animation scroll-animation-default delay-300"
      >
        Award&amp;Exhibitions
      </h1>
    </div>

    <div class="mt-1 hidden md:block">
      <ExpBottom client:load />
    </div>

    <ExperienceContent client:load />
  

  <!-- Skills section with left label column matching About Me style -->
  <div class="flex relative">
    <div class="w-24 shrink-0 hidden md:block"></div>

    <div class="flex-1 min-w-0">
      <div class="px-6 md:px-16 mt-8 md:mt-4">
        <h1
          class="font-bold text-3xl italic scroll-animation scroll-animation-default delay-300"
        >
          Skills
        </h1>
      </div>

      <div class="mt-1 w-full overflow-hidden hidden md:block -ml-48">
        <SkillsBottom client:load />
      </div>

      <SkillsContent client:load />
    </div>
  </div>
</section>
