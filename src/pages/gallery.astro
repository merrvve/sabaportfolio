---
import Layout from "../layouts/Layout.astro"
import Navbar from "../components/Navbar.astro"
---
<style>
    
    .gallery {
        width: 100%;
        height: 100vh;
         background: radial-gradient(
    farthest-side at bottom left,
    rgba(255, 0, 255, 0.5), 
    transparent
  ),
  radial-gradient(
    farthest-side at top left,
    rgba(240,98,146,0.5), 
    transparent
  ),
  radial-gradient(
    farthest-side at bottom right,
    rgba(241,207,116,0.69), 
    transparent
  ),
  radial-gradient(
    farthest-corner at top right,
    rgba(255, 50, 50, 0.5), 
    transparent
  );
    }
</style>
<Layout title="Saba Design | Gallery" description="Saba Sen Portfolio Website"  >

    <section class="gallery relative">
            <Navbar />
        <div class="flex items-center justify-center h-[70vh] p-4">Gallery</div>
    </section>
</Layout>